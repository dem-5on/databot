# ============================================================
# ENVIRONMENT (REQUIRED)
# ============================================================
# Set to 'production' for production deployments
# When 'production', security settings become mandatory
ENVIRONMENT=development

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5432/databot_db

# ============================================================
# PAYSTACK CONFIGURATION
# ============================================================
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_GENERATE_FROM_PAYSTACK
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME_GENERATE_FROM_PAYSTACK

# ============================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================
TELEGRAM_BOT_TOKEN=0000000000:CHANGE_ME_GET_FROM_BOTFATHER
# Comma-separated list of admin Telegram user IDs (get your ID from @userinfobot)
TELEGRAM_ADMIN_IDS=123456789

# Telegram Webhook Configuration (Production)
# Set TELEGRAM_USE_WEBHOOK=true for production webhook mode
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=false

# Optional: Telegram API URL
TELEGRAM_API_URL=https://api.telegram.org/bot

# ============================================================
# BLESSDATAHUB CONFIGURATION (Data Vendor)
# ============================================================
BLESSDATAHUB_API_URL=https://www.blessdatahub.com/api
BLESSDATAHUB_API_KEY=CHANGE_ME_GET_FROM_BLESSDATAHUB
BLESSDATAHUB_API_SECRET=CHANGE_ME_GET_FROM_BLESSDATAHUB
BLESSDATAHUB_PURCHASE_TIMEOUT=60

# ============================================================
# BACKEND API CONFIGURATION
# ============================================================
BACKEND_API_URL=http://localhost:8000

# ============================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_KEY=CHANGE_ME_GET_FROM_SUPABASE_DASHBOARD

# ============================================================
# WHATSAPP CLOUD API CONFIGURATION
# ============================================================
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_GET_FROM_META
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_GET_FROM_META
WHATSAPP_APP_ID=CHANGE_ME_GET_FROM_META
WHATSAPP_APP_SECRET=CHANGE_ME_GET_FROM_META
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_GENERATE_RANDOM_STRING
WHATSAPP_ADMIN_NUMBERS=233000000000
WHATSAPP_BUSINESS_PHONE=233000000000

# ============================================================
# SECURITY & AUTHENTICATION (REQUIRED FOR PRODUCTION)
# ============================================================

# Bot Backend Secret - Shared secret for HMAC signature verification
# REQUIRED in production. Generate with: openssl rand -hex 32
# This secret should be the SAME in your bot's .env and backend .env
BOT_BACKEND_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32

# Admin API Keys - Comma-separated list of admin API keys
# REQUIRED in production. Generate with: openssl rand -hex 32 (for each key)
ADMIN_API_KEYS=CHANGE_ME_key1,CHANGE_ME_key2

# Dashboard Token - Token for monitoring dashboard access
# REQUIRED in production. Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32

# Maximum amount that can be manually credited at once (business logic limit)
MAX_MANUAL_CREDIT_AMOUNT=10000.0

# ============================================================
# OPERATIONAL CONFIGURATION
# ============================================================

# Purchase timeout in seconds
PURCHASE_TIMEOUT=60

# Min deposit amount
MINIMUM_DEPOSIT_AMOUNT=1

# HTTP Connection Pool Settings
MAX_KEEPALIVE_CONNECTIONS=20
MAX_CONNECTIONS=100

# Referral Configuration
REFERRAL_BONUS_AMOUNT=5.00

# Price Markup Percentage (e.g., 10 for 10% markup)
PRICE_MARKUP_PERCENTAGE=10

# CORS Configuration
# SECURITY: Do NOT use '*' in production - set to your domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Uvicorn Workers (Set to 1 for development, 4+ for production)
UVICORN_WORKERS=1

# ============================================================
# CELERY CONFIGURATION (Background Tasks)
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0