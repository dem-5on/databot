# Database Configuration
DATABASE_URL=postgresql+asyncpg://me:password@localhost:5432/databot_db

# Paystack Configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
# Comma-separated list of admin Telegram user IDs (get your ID from @userinfobot)
TELEGRAM_ADMIN_IDS=

# DatamartGH Configuration
DATAMART_API_URL=https://api.datamartgh.shop/api/developer
# Get API key from: https://www.datamartgh.shop
DATAMART_API_KEY=

# Backend API Configuration
# URL where the FastAPI backend is running (for bot to call)
BACKEND_API_URL=http://localhost:8000

# Optional: Telegram API URL
TELEGRAM_API_URL=https://api.telegram.org/bot

# Optional: Purchase timeout in seconds (defaults to 60.0 if not set)
PURCHASE_TIMEOUT=60.0

# min deposit amount
MINIMUM_DEPOSIT_AMOUNT=1

# HTTP Connection Pool Settings (optional, defaults shown)
MAX_KEEPALIVE_CONNECTIONS=20
MAX_CONNECTIONS=100