# Database Configuration
DATABASE_URL=postgresql+asyncpg://me:password@localhost:5432/databot_db

# Paystack Configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
# Comma-separated list of admin Telegram user IDs (get your ID from @userinfobot)
TELEGRAM_ADMIN_IDS=

# DatamartGH Configuration (DEPRECATED - kept for backwards compatibility)
# DATAMART_API_URL=https://api.datamartgh.shop/api/developer
# DATAMART_API_KEY=

# Blessdatahub Configuration (Primary data vendor)
# API Documentation: https://www.blessdatahub.com/api-docs
BLESSDATAHUB_API_URL=https://www.blessdatahub.com/api
BLESSDATAHUB_API_KEY=your_api_key
BLESSDATAHUB_API_SECRET=your_api_secret
BLESSDATAHUB_PURCHASE_TIMEOUT=60

# Backend API Configuration
# URL where the FastAPI backend is running (for bot to call)
BACKEND_API_URL=http://localhost:8000

# Optional: Telegram API URL
TELEGRAM_API_URL=https://api.telegram.org/bot

# Telegram Webhook Configuration (Production)
# Set TELEGRAM_USE_WEBHOOK=true for production webhook mode
# TELEGRAM_WEBHOOK_URL should be your public HTTPS domain (e.g., https://api.yourdomain.com)
# TELEGRAM_WEBHOOK_SECRET is a random string for webhook validation (security best practice)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=false

# Purchase timeout in seconds
PURCHASE_TIMEOUT=60

# Min deposit amount
MINIMUM_DEPOSIT_AMOUNT=1

# HTTP Connection Pool Settings (optional, defaults shown)
MAX_KEEPALIVE_CONNECTIONS=20
MAX_CONNECTIONS=100

# ============================================================
# SECURITY & AUTHENTICATION (Required for Production)
# ============================================================

# Bot Backend Secret - Shared secret for HMAC signature verification
# Generate with: openssl rand -hex 32
# This secret should be the SAME in your bot's .env and backend .env
BOT_BACKEND_SECRET=your_random_secret_here_generate_with_openssl

# Admin API Keys - Comma-separated list of admin API keys
# Generate with: openssl rand -hex 32 (for each key)
# Example: ADMIN_API_KEYS=key1_abc123...,key2_def456...
ADMIN_API_KEYS=admin_key_1,admin_key_2

# Dashboard Token - 64-character token for monitoring dashboard access
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=your_64_char_dashboard_token_here

# ============================================================
# ADDITIONAL CONFIGURATION
# ============================================================

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_APP_ID=your_app_id
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_ADMIN_NUMBERS=233XXXXXXXXX,233YYYYYYYYY
WHATSAPP_BUSINESS_PHONE=233XXXXXXXXX

# Referral Configuration
REFERRAL_BONUS_AMOUNT=5.00

# Price Markup Percentage (e.g., 10 for 10% markup)
PRICE_MARKUP_PERCENTAGE=10

# CORS Configuration (Production: set to your domain)
ALLOWED_ORIGINS=*

# Uvicorn Workers (Set to 1 for development, 4+ for production)
UVICORN_WORKERS=1

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0